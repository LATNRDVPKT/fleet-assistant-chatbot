# ============================================================
# Fleet Copilot configuration. Copy to .env and edit:   cp .env.example .env
# Every value is optional; defaults live in app/core/config.py
# (Comments must be on their own line: Docker reads this file too.)
# ============================================================

# ---- general ----
# local | dev | prod
ENVIRONMENT=local
# INFO shows every step; DEBUG adds every chunk drop decision
LOG_LEVEL=INFO
# text = easy to read in a terminal, json = best for CloudWatch Logs Insights
LOG_FORMAT=text

# ---- API access ----
# Comma-separated "key:tenant" pairs. Generate keys with: openssl rand -hex 24
API_KEYS=5954599c3346c81c53787926acefcd26e84a6186acc33065:demo-tenant
# The key the Streamlit UI container uses (must be one of API_KEYS)
UI_API_KEY=5954599c3346c81c53787926acefcd26e84a6186acc33065
# Requests per minute per API key (per worker process)
RATE_LIMIT_PER_MINUTE=60
# Requests running at once per worker process; more → HTTP 503 FC-5004
MAX_INFLIGHT_REQUESTS=32
# Uvicorn worker processes (about vCPUs − 2 on a dedicated server)
WORKERS=2

# ---- embeddings + reranker ----
# local = real model (downloaded once; baked into the Docker image)
# hash  = offline, no downloads (tests / quick demo)
EMBEDDING_PROVIDER=local
# cross-encoder | lexical | none
RERANKER=cross-encoder

# ---- LLM ----
# extractive = no LLM, quotes the manuals (free, offline)
# bedrock    = Claude on Amazon Bedrock (recommended on AWS)
LLM_PROVIDER=extractive
AWS_REGION=ap-south-1
# Check the exact model id / inference profile id in the Bedrock console (step 2 of the AWS guide)
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
FALLBACK_TO_EXTRACTIVE=true

# ---- only if LLM_PROVIDER=openai (also: pip install openai) ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- CloudWatch metrics from log lines (set true on AWS) ----
EMIT_EMF_METRICS=false
